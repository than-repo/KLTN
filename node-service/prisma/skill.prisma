enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Skill {
  id            String     @id @default(cuid())
  courseId      String     @map("course_id")
  canonicalName String     @map("canonical_name")
  description   String?    @db.Text
  aliases       Json?
  embedding     Json?
  parentId      String?    @map("parent_id")
  level         Int        @default(0)
  difficulty    Difficulty @default(EASY)
  isActive      Boolean    @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  parent   Skill?   @relation("SkillHierarchy", fields: [parentId], references: [id])
  children Skill[]  @relation("SkillHierarchy")
  lessons  Lesson[] @relation("LessonSkills")

  @@unique([courseId, canonicalName])
  @@index([parentId])
  @@index([isActive])
  @@map("skills")
}
