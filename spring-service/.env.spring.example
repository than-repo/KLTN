SEPAY_ERROR_URL=http://localhost:3001/payments/sepay/return
SEPAY_CANCEL_URL=http://localhost:3001/payments/sepay/return
# Set the matching public API endpoint manually in SePay's merchant dashboard.
SEPAY_IPN_URL=https://your-public-api-host/api/payments/sepay/ipn